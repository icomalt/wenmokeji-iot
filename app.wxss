/* ================================================
 * 红蓝工业风 Design Token —— 全局样式
 * 主蓝: #1A365D  深邃稳重
 * 主红: #DC2626  警示醒目
 * 辅蓝: #2563EB  交互强调
 * 在线: #10B981  正常状态
 * 背景: #F1F5F9  浅灰蓝
 * 深色: #0F172A  主文字
 * 次级: #64748B  次文字
 * 边框: #E2E8F0  分隔线
 * ================================================ */

page {
  background: #F1F5F9;
  font-size: 28rpx;
  color: #0F172A;
  font-family: -apple-system, "Helvetica Neue", "PingFang SC", sans-serif;
  box-sizing: border-box;
}

/* ---- 安全区域适配 ---- */
.safe-top {
  padding-top: env(safe-area-inset-top);
}
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
.safe-bottom-lg {
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}
/* iPhone X 底部 TabBar 安全距离 */
.tabbar-safe {
  height: calc(100rpx + env(safe-area-inset-bottom));
}

/* ---- 卡片 ---- */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(26, 54, 93, 0.06);
  border: 1rpx solid #E2E8F0;
}

/* ---- 主按钮（红） ---- */
.btn-primary {
  background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
  color: #fff;
  border-radius: 14rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(220, 38, 38, 0.3);
}
.btn-primary::after {
  border: none;
}
.btn-primary[disabled] {
  background: #CBD5E1;
  color: #fff;
  box-shadow: none;
}

/* ---- 次要按钮（蓝） ---- */
.btn-secondary {
  background: linear-gradient(135deg, #1A365D 0%, #152E4D 100%);
  color: #fff;
  border-radius: 14rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 54, 93, 0.25);
}
.btn-secondary::after {
  border: none;
}

/* ---- 幽灵按钮（蓝边框） ---- */
.btn-ghost {
  background: #fff;
  color: #1A365D;
  border: 2rpx solid #1A365D;
  border-radius: 14rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
}
.btn-ghost::after {
  border: none;
}

/* ---- 卡片标题（带左侧红色色条） ---- */
.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #DC2626;
  color: #0F172A;
}

/* ---- 空数据占位 ---- */
.empty {
  text-align: center;
  padding: 160rpx 0;
  color: #94A3B8;
  font-size: 26rpx;
}
.empty .empty-icon {
  font-size: 96rpx;
  color: #CBD5E1;
  display: block;
  margin-bottom: 24rpx;
}
.empty text {
  display: block;
}
.empty .empty-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1.6;
  padding: 0 60rpx;
}

/* ---- 骨架屏 ---- */
.skeleton {
  background: linear-gradient(90deg, #F1F5F9 25%, #E2E8F0 37%, #F1F5F9 63%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: skeleton-loading 1.4s ease infinite;
}
@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
.skeleton-line {
  height: 32rpx;
  margin: 16rpx 0;
}
.skeleton-card {
  height: 200rpx;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
}

/* ---- 上拉加载提示 ---- */
.load-tip {
  text-align: center;
  color: #94A3B8;
  font-size: 24rpx;
  padding: 24rpx 0 48rpx;
}

/* ---- 加载中提示 ---- */
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  color: #94A3B8;
  font-size: 26rpx;
}
.loading-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  background: #94A3B8;
  border-radius: 50%;
  animation: dot-bounce 1.4s infinite ease-in-out both;
}
.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* ---- 状态标签 ---- */
.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-online   { background: #ECFDF5; color: #059669; }
.tag-offline  { background: #F1F5F9; color: #64748B; }
.tag-fault    { background: #FEF2F2; color: #DC2626; }
.tag-type     { background: #EFF6FF; color: #1A365D; }
.tag-success  { background: #ECFDF5; color: #059669; }
.tag-danger   { background: #FEF2F2; color: #DC2626; }

/* ---- 辅助样式 ---- */
.muted { color: #64748B; }
.small { font-size: 24rpx; }
.bold { font-weight: bold; }
.center { text-align: center; }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.divider {
  height: 1rpx;
  background: #E2E8F0;
  margin: 16rpx 0;
}
.flex {
  display: flex;
  align-items: center;
}
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.flex-1 {
  flex: 1;
}

/* ---- 输入框通用 ---- */
.input-base {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
  font-size: 28rpx;
}
.input-base:focus {
  border-color: #2563EB;
  background: #fff;
}

/* ---- 页面通用内边距 ---- */
.page {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* ---- 断网页络提示条 ---- */
.network-offline-tip {
  background: #FEF2F2;
  color: #DC2626;
  text-align: center;
  font-size: 24rpx;
  padding: 12rpx 0;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
}
