<!--
  设备详情页：展示公司平台 device/info 返回的只读信息。
-->
<view class="page">
  <view wx:if="{{!device && !loadDone}}" class="empty">
    <text class="empty-icon">📡</text>设备信息加载中...
  </view>

  <view wx:elif="{{!device && loadDone}}" class="empty">
    <text class="empty-icon">🚫</text>
    <text>设备不存在</text>
    <text class="empty-tip">该设备可能已被移除，或您暂无查看权限</text>
  </view>

  <block wx:else>
    <view class="card">
      <view class="d-head">
        <text class="d-name">{{device.deviceName}}</text>
        <text class="tag {{device.onlineStatus === 2 ? 'tag-online' : (device.onlineStatus === 1 ? 'tag-inactive' : 'tag-offline')}}">{{device.statusText}}</text>
      </view>
      <view class="d-row"><text class="muted">设备ID</text><text>{{device.deviceId || '--'}}</text></view>
      <view class="d-row"><text class="muted">产品型号</text><text class="tag tag-type">{{device.deviceType || '--'}}</text></view>
      <view class="d-row"><text class="muted">当前时间</text><text>{{currentTime}}</text></view>
    </view>

    <view class="card">
      <view class="card-title">设备状态</view>
      <view class="d-row"><text class="muted">IMEI</text><text>{{device.imei || '--'}}</text></view>
      <view class="d-row"><text class="muted">ICCID</text><text>{{device.iccid || '--'}}</text></view>
      <view class="d-row"><text class="muted">信号强度</text><text>{{device.signalStrength || '--'}}</text></view>
      <view class="d-row"><text class="muted">模组电压</text><text>{{device.batteryVoltage || '--'}}</text></view>
      <view class="d-row"><text class="muted">通电状态</text><text>{{device.powerType || '--'}}</text></view>
      <view class="d-row"><text class="muted">传感器数量</text><text>{{device.sensorCount || '--'}}</text></view>
      <view class="d-row"><text class="muted">CPU 使用</text><text>{{device.cpu || '--'}}</text></view>
      <view class="d-row"><text class="muted">内存使用</text><text>{{device.memoryUsage || '--'}}</text></view>
      <view class="d-row"><text class="muted">硬盘使用</text><text>{{device.diskUsage || '--'}}</text></view>
      <view class="d-row"><text class="muted">上行流量</text><text>{{device.upFlow || '--'}}</text></view>
      <view class="d-row"><text class="muted">下行流量</text><text>{{device.downFlow || '--'}}</text></view>
    </view>

    <view class="card">
      <view class="card-title">
        <text>设备参数</text>
        <text class="refresh-btn" bindtap="fetchParams">{{paramsLoading ? '读取中...' : '刷新'}}</text>
      </view>
      <view wx:if="{{paramsLoading}}" class="params-loading">读取中...</view>
      <view wx:elif="{{params.length === 0}}" class="params-empty" bindtap="fetchParams">点击刷新读取设备参数</view>
      <view wx:else>
        <view class="d-row" wx:for="{{params}}" wx:key="key">
          <text class="muted">{{item.name || item.key}}</text>
          <text>{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{device.latitude || device.longitude}}">
      <view class="card-title">位置信息</view>
      <view class="d-row"><text class="muted">纬度</text><text>{{device.latitude || '--'}}</text></view>
      <view class="d-row"><text class="muted">经度</text><text>{{device.longitude || '--'}}</text></view>
    </view>

    <view class="card">
      <view class="card-title">用户与版本</view>
      <view class="d-row" wx:if="{{username}}"><text class="muted">当前账号</text><text>{{username}}</text></view>
      <view class="d-row"><text class="muted">公司名称</text><text>{{device.companyName || '--'}}</text></view>
      <view class="d-row"><text class="muted">设备用户</text><text>{{device.customerName || '--'}}</text></view>
      <view class="d-row"><text class="muted">DMS 版本</text><text>{{device.firmwareVersion || '--'}}</text></view>
      <view class="d-row"><text class="muted">最近登录</text><text>{{device.lastLogin || '--'}}</text></view>
      <view class="d-row"><text class="muted">在线时长</text><text>{{device.onlineDuration || '--'}}</text></view>
      <view class="d-row"><text class="muted">离线时长</text><text>{{device.offlineDuration || '--'}}</text></view>
      <view class="d-row"><text class="muted">更新时间</text><text>{{device.updateTime || '--'}}</text></view>
    </view>

    <view class="actions">
      <button class="btn-primary" bindtap="goPrint">喷码打印</button>
      <button class="btn-danger" bindtap="rebootDevice" wx:if="{{isAdmin}}">重启设备</button>
    </view>
  </block>
</view>