/* ================================================
 * 设备列表页 - 红蓝工业风
 * ================================================ */

.search {
  padding: 20rpx 28rpx;
  margin-top: 24rpx;
}

.search-input {
  height: 72rpx;
  background: #F1F5F9;
  border: 1rpx solid #E2E8F0;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #0F172A;
}

/* 实时连接状态条 */
.ws-status {
  text-align: center;
  font-size: 24rpx;
  padding: 16rpx 0;
  color: #fff;
  letter-spacing: 2rpx;
  font-weight: 500;
}
.ws-status.on {
  background: linear-gradient(90deg, #10B981 0%, #059669 100%);
}
.ws-status.off {
  background: linear-gradient(90deg, #DC2626 0%, #B91C1C 100%);
}

/* 列表项 - 设备卡片 */
.item {
  position: relative;
  transition: transform 0.2s;
}
.item:active {
  transform: scale(0.98);
}

.item-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-head .name {
  font-size: 34rpx;
  font-weight: bold;
  flex: 1;
  color: #0F172A;
}

.item-head .tag {
  margin-left: 12rpx;
}

.item-row {
  display: flex;
  align-items: center;
  margin: 10rpx 0;
}

.item-row.muted {
  color: #64748B;
  font-size: 26rpx;
}

.item-row .id {
  margin-left: 20rpx;
  color: #94A3B8;
  font-size: 24rpx;
}

/* 列表项底部装饰线 */
.item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 28rpx;
  right: 28rpx;
  height: 1rpx;
  background: #E2E8F0;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-type {
  background: #EFF6FF;
  color: #1A365D;
}
.tag-online {
  background: #ECFDF5;
  color: #059669;
}
.tag-offline {
  background: #F1F5F9;
  color: #64748B;
}
.tag-fault {
  background: #FEF2F2;
  color: #DC2626;
}

/* 空数据提示 */
.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #64748B;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}
.empty-tip {
  display: block;
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 12rpx;
}

/* 加载提示 */
.load-tip {
  text-align: center;
  padding: 32rpx 0;
  color: #94A3B8;
  font-size: 24rpx;
}
