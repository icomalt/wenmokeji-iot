/* ================================================
 * 打印下发页 - 红蓝工业风
 * ================================================ */

.d-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #E2E8F0;
  font-size: 28rpx;
}

.d-row .muted {
  color: #64748B;
  font-weight: 500;
}

.d-row text:last-child {
  color: #0F172A;
  font-weight: 500;
}

.form-block {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.form-block.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  color: #64748B;
  margin-bottom: 16rpx;
  font-weight: 500;
  font-size: 28rpx;
}

.form-block.row .form-label {
  margin-bottom: 0;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #0F172A;
  line-height: 1.6;
}

.count {
  text-align: right;
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 12rpx;
}

.input {
  height: 72rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #0F172A;
}

.actions {
  padding: 40rpx 24rpx;
}

.actions .btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
}
