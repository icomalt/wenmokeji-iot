<!--
  打印下发页
  功能：输入打印内容 + 字体大小 + 喷印次数 + 是否立即执行 → 下发到目标设备
-->
<view class="page">
  <view class="card">
    <view class="card-title">下发打印任务</view>

    <view class="d-row">
      <text class="muted">目标设备</text>
      <text>{{deviceName || deviceId}}</text>
    </view>

    <!-- 打印内容 -->
    <view class="form-block">
      <text class="form-label">打印内容</text>
      <textarea class="textarea" placeholder="请输入需喷印的文本内容"
        value="{{content}}" bindinput="onInput" data-key="content" maxlength="200"/>
      <view class="count">{{content.length}}/200</view>
    </view>

    <!-- 字体大小 -->
    <view class="form-block">
      <text class="form-label">字体大小</text>
      <slider min="8" max="48" value="{{fontSize}}" show-value bindchange="onSlider" data-key="fontSize"/>
    </view>

    <!-- 喷印次数 -->
    <view class="form-block">
      <text class="form-label">喷印次数</text>
      <input class="input" type="number" value="{{count}}" bindinput="onInput" data-key="count"/>
    </view>

    <!-- 是否立即执行 -->
    <view class="form-block row">
      <text class="form-label">立即执行</text>
      <switch checked="{{immediate}}" bindchange="onSwitch" data-key="immediate"/>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">下发</button>
  </view>
</view>
