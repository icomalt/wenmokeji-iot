<!--
  喷码打印页：设备来自平台 k300_list，内容确认后由用户手动下发。
-->
<view class="page">
  <view class="card">
    <view class="card-title">喷码打印</view>

    <view class="form-block">
      <text class="form-label">喷码设备</text>
      <picker mode="selector" range="{{deviceOptions}}" range-key="label" value="{{selectedDevIndex}}" bindchange="onDeviceChange" disabled="{{deviceOptions.length === 0}}">
        <view class="input">{{deviceId || (deviceOptions.length ? '请选择喷码设备' : '暂无可喷印设备')}}</view>
      </picker>
      <view wx:if="{{deviceCompanyName}}" class="device-state">公司名称：{{deviceCompanyName}}</view>
      <view wx:if="{{deviceStatusText}}" class="device-state">设备状态：{{deviceStatusText}}</view>
    </view>

    <view class="form-block">
      <text class="form-label">打印内容</text>
      <textarea class="textarea" placeholder="请输入需喷印的文本内容"
        value="{{content}}" bindinput="onInput" data-key="content" maxlength="500"/>
      <view class="content-actions">
        <view class="count">{{content.length}}/500</view>
        <view class="insert-time-btn" bindtap="openTimeModal">插入时间</view>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting || !deviceId}}" bindtap="onSubmit">开始喷印</button>
  </view>

  <view class="modal-mask" wx:if="{{showTimeModal}}" bindtap="closeTimeModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">时间格式</text>
        <text class="modal-close" bindtap="closeTimeModal">×</text>
      </view>

      <view class="modal-preview">
        <text class="muted">时间格式预览</text>
        <text class="preview-value">{{timePreview}}</text>
      </view>

      <view class="format-row">
        <view class="format-item">
          <text class="format-label">年份格式</text>
          <picker mode="selector" range="{{yearOptions}}" value="{{yearIdx}}" bindchange="onYearChange">
            <view class="picker-box">{{yearOptions[yearIdx]}}</view>
          </picker>
        </view>
        <view class="format-item">
          <text class="format-label">月份格式</text>
          <picker mode="selector" range="{{partOptions}}" value="{{monthIdx}}" bindchange="onMonthChange">
            <view class="picker-box">{{partOptions[monthIdx]}}</view>
          </picker>
        </view>
        <view class="format-item">
          <text class="format-label">日期格式</text>
          <picker mode="selector" range="{{partOptions}}" value="{{dayIdx}}" bindchange="onDayChange">
            <view class="picker-box">{{partOptions[dayIdx]}}</view>
          </picker>
        </view>
      </view>

      <view class="format-row">
        <view class="format-item">
          <text class="format-label">小时格式</text>
          <picker mode="selector" range="{{partOptions}}" value="{{hourIdx}}" bindchange="onHourChange">
            <view class="picker-box">{{partOptions[hourIdx]}}</view>
          </picker>
        </view>
        <view class="format-item">
          <text class="format-label">分钟格式</text>
          <picker mode="selector" range="{{partOptions}}" value="{{minuteIdx}}" bindchange="onMinuteChange">
            <view class="picker-box">{{partOptions[minuteIdx]}}</view>
          </picker>
        </view>
        <view class="format-item">
          <text class="format-label">秒格式</text>
          <picker mode="selector" range="{{partOptions}}" value="{{secondIdx}}" bindchange="onSecondChange">
            <view class="picker-box">{{partOptions[secondIdx]}}</view>
          </picker>
        </view>
      </view>

      <view class="format-row">
        <view class="format-item">
          <text class="format-label">年月日连接符</text>
          <input class="separator-input" value="{{dateSeparator}}" bindinput="onDateSeparatorInput"/>
        </view>
        <view class="format-item">
          <text class="format-label">时分秒连接符</text>
          <input class="separator-input" value="{{timeSeparator}}" bindinput="onTimeSeparatorInput"/>
        </view>
      </view>

      <view class="modal-buttons">
        <view class="modal-btn confirm" bindtap="confirmTimeFormat">确定</view>
        <view class="modal-btn cancel" bindtap="closeTimeModal">取消</view>
      </view>
    </view>
  </view>
</view>