<!--
  首页（Tab）
  功能：欢迎栏 + 设备统计概览 + 快捷功能入口
  数据来源：/device/list
-->
<view class="page">
  <!-- 顶部欢迎栏 -->
  <view class="hero">
    <view class="hero-brand">
      <image class="hero-logo" src="/images/logo.png" mode="widthFix" binderror="onLogoError" wx:if="{{logoExists}}"/>
      <view class="hero-logo-fallback" wx:else>
        <view class="mini-ink">
          <text class="mini-ink-char">墨</text>
        </view>
        <text class="hero-title">文墨喷码</text>
      </view>
    </view>
    <view class="hero-sub">
      <text>欢迎，{{username}}</text>
      <text class="hero-logout" bindtap="logout">退出</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view wx:if="{{loading}}" class="stat-grid">
    <view class="stat-card" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="skeleton" style="height: 120rpx; border-radius: 16rpx;"></view>
    </view>
  </view>
  <view wx:else class="stat-grid">
    <view class="stat-card" bindtap="goDevice">
      <text class="stat-num">{{deviceStat.total || 0}}</text>
      <text class="stat-lbl">设备总数</text>
    </view>
    <view class="stat-card online" bindtap="goDevice">
      <text class="stat-num">{{deviceStat.online || 0}}</text>
      <text class="stat-lbl">在线</text>
    </view>
    <view class="stat-card inactive" bindtap="goDevice">
      <text class="stat-num">{{deviceStat.inactive || 0}}</text>
      <text class="stat-lbl">未激活</text>
    </view>
    <view class="stat-card" bindtap="goDevice">
      <text class="stat-num">{{deviceStat.offline || 0}}</text>
      <text class="stat-lbl">离线</text>
    </view>
  </view>

  <!-- 设备管理区域（双角色适配） -->
  <view class="card">
    <view class="card-title">{{isAdmin ? '设备总览' : '我的设备'}}</view>
    <view class="mgmt-btns">
      <!-- 公司端（admin）：设备列表入口 -->
      <view class="mgmt-btn add" bindtap="goDevice" wx:if="{{isAdmin}}">
        <text class="mgmt-icon">▣</text>
        <text class="mgmt-lbl">设备列表</text>
      </view>
      <!-- 客户端（operator/viewer）：远程喷印入口 -->
      <view class="mgmt-btn add" bindtap="goPrint" wx:else>
        <text class="mgmt-icon">▶</text>
        <text class="mgmt-lbl">远程喷印</text>
      </view>
      <view class="mgmt-btn history" bindtap="goHistory">
        <text class="mgmt-icon">▤</text>
        <text class="mgmt-lbl">喷印记录</text>
      </view>
    </view>
  </view>

  <!-- 更多功能 -->
  <view class="card">
    <view class="card-title">更多功能</view>
    <view class="mgmt-btns">
      <view class="mgmt-btn alarm" bindtap="goAlarm">
        <text class="mgmt-icon">⚠</text>
        <text class="mgmt-lbl">告警中心</text>
      </view>
      <view class="mgmt-btn password" bindtap="goPassword">
        <text class="mgmt-icon">🔒</text>
        <text class="mgmt-lbl">修改密码</text>
      </view>
    </view>
  </view>

  <view class="footer-tip">Industrial Inkjet IoT Cloud v1.0</view>
</view>
