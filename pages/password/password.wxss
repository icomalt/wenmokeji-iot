.page {
  min-height: 100vh;
  background: #F1F5F9;
  padding: 32rpx;
  box-sizing: border-box;
}
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.form-item {
  margin-bottom: 32rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #475569;
  margin-bottom: 12rpx;
}
.form-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #F8FAFC;
}
.submit-btn {
  margin-top: 48rpx;
  background: #1A365D;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}
.submit-btn[disabled] {
  background: #94A3B8;
}
.tip {
  text-align: center;
  color: #94A3B8;
  font-size: 24rpx;
  margin-top: 32rpx;
}
