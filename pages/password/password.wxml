<!-- 修改密码页 -->
<view class="page">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">旧密码</text>
      <input class="form-input" type="password" placeholder="请输入旧密码" data-key="oldPassword" value="{{oldPassword}}" bindinput="onInput" password/>
    </view>
    <view class="form-item">
      <text class="form-label">新密码</text>
      <input class="form-input" type="password" placeholder="至少6位" data-key="newPassword" value="{{newPassword}}" bindinput="onInput" password/>
    </view>
    <view class="form-item">
      <text class="form-label">确认新密码</text>
      <input class="form-input" type="password" placeholder="再次输入新密码" data-key="confirmPassword" value="{{confirmPassword}}" bindinput="onInput" password/>
    </view>
    <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? '提交中...' : '确认修改'}}</button>
  </view>
  <view class="tip">修改成功后需用新密码重新登录</view>
</view>
