<!--
  喷印记录页：数据来自平台 inkjet_printer/list。
-->
<view class="page">
  <view class="filter card">
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="picker {{date ? 'active' : ''}}">{{date || '选择日期筛选'}}</view>
    </picker>
    <view wx:if="{{date}}" class="clear" bindtap="clearDate">清除</view>
  </view>

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">
    <text class="empty-icon">📋</text>暂无喷印记录
  </view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="index" class="card item">
      <view class="item-head">
        <text class="r-time">{{item.created_at || item.print_time || '--'}}</text>
        <text class="r-device">{{item.dev_id || '--'}}</text>
      </view>
      <view class="r-company">公司名称：{{item.companyName || '--'}}</view>
      <view class="r-content">{{item.content || item.print_content || '--'}}</view>
    </view>
  </view>

  <view wx:if="{{list.length > 0}}" class="load-tip">
    {{hasMore ? '上拉加载更多...' : '没有更多了'}}
  </view>
</view>