.container {
  padding: 32rpx;
  background: #F1F5F9;
  min-height: 100vh;
  box-sizing: border-box;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A365D;
  text-align: center;
  margin-bottom: 12rpx;
}
.update {
  font-size: 24rpx;
  color: #94A3B8;
  text-align: center;
  margin-bottom: 32rpx;
}
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.h2 {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A365D;
  margin-bottom: 16rpx;
}
.p {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.7;
  margin-bottom: 12rpx;
}
.footer {
  text-align: center;
  font-size: 24rpx;
  color: #94A3B8;
  padding: 24rpx 0 48rpx;
}
